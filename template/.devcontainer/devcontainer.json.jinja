{
  "name": "{{ project_name }}",
{%- if base_container == "universal" %}
  "image": "mcr.microsoft.com/devcontainers/universal:2",
{%- else %}
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
{%- endif %}

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/{{ project_name }},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/{{ project_name }}",

  "mounts": [
{%- if base_container == "node" or add_node %}
    "source={{ project_name }}-node-modules,target=/workspaces/{{ project_name }}/node_modules,type=volume",
{%- endif %}
{%- if base_container == "go" or add_go %}
    "source={{ project_name }}-go-mod,target=/home/vscode/go/pkg/mod,type=volume",
{%- endif %}
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached"
  ],

  "features": {
{%- if base_container == "python" or add_python %}
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
{%- endif %}
{%- if base_container == "node" or add_node %}
    "ghcr.io/devcontainers/features/node:1": { "version": "22", "installYarnUsingApt": false },
{%- endif %}
{%- if base_container == "go" or add_go %}
    "ghcr.io/devcontainers/features/go:1": { "version": "1.22" },
{%- endif %}
{%- if base_container == "java" or add_java %}
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
{%- endif %}
{%- if add_rust %}
    "ghcr.io/devcontainers/features/rust:1": {},
{%- endif %}
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

{%- if use_1password %}
  "initializeCommand": "./.devcontainer/init-1password.sh",
{%- endif %}
  "postCreateCommand": "./.devcontainer/post-create.sh",
{%- if use_1password %}
  "postStartCommand": "./.devcontainer/setup-secrets.sh",
{%- endif %}

  "remoteEnv": {
    "BD_SOCKET": "/tmp/beads.sock"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "planet57.vscode-beads"
      ]
    }
  }
}
