#!/bin/bash
# Initialize 1Password vault for this project (runs on HOST via initializeCommand)
# Requires: op CLI installed and signed in on host

set -e

VAULT_NAME="{{ op_vault }}"

echo "=== 1Password Setup for {{ project_name }} ==="

# Check if op is available
if ! command -v op &> /dev/null; then
    echo "ERROR: 1Password CLI (op) not found on host."
    echo "Install from: https://1password.com/downloads/command-line/"
    exit 1
fi

# Check if signed in
if ! op account list &> /dev/null; then
    echo "ERROR: Not signed in to 1Password. Run 'op signin' first."
    exit 1
fi

echo "Using vault: $VAULT_NAME"

# Create vault if needed
if op vault get "$VAULT_NAME" &> /dev/null; then
    echo "✓ Vault exists"
else
    echo "Creating vault '$VAULT_NAME'..."
    op vault create "$VAULT_NAME"
    echo "✓ Vault created"
fi

# Check/create SSH key
if op item list --vault "$VAULT_NAME" --tags devcontainer --categories "SSH Key" --format json 2>/dev/null | grep -q '"id"'; then
    echo "✓ SSH key exists (tagged 'devcontainer')"
else
    echo ""
    echo "No SSH key found in vault."
    echo ""
    echo "Options:"
    echo "  1. Generate new key for this project (recommended)"
    echo "  2. Import existing key from ~/.ssh/"
    echo "  0. Skip"
    echo ""
    read -p "Choice [1]: " ssh_choice
    ssh_choice=${ssh_choice:-1}

    case "$ssh_choice" in
        1)
            # Generate new project-specific key
            TEMP_KEY=$(mktemp)
            rm -f "$TEMP_KEY"  # ssh-keygen wants to create it
            echo "Generating new SSH key for {{ project_name }}..."
            ssh-keygen -t ed25519 -C "{{ project_name }}-devcontainer" -f "$TEMP_KEY" -N ""

            # Store in 1Password
            echo "Storing key in 1Password..."
            op item create --category "SSH Key" --vault "$VAULT_NAME" \
                --title "devcontainer-ssh-key" \
                --tags "devcontainer" \
                "private key[password]=$(cat "$TEMP_KEY")" \
                "public key[text]=$(cat "$TEMP_KEY.pub")"

            # Add to GitHub if gh is authenticated
            if gh auth status &>/dev/null; then
                echo "Adding public key to GitHub..."
                gh ssh-key add "$TEMP_KEY.pub" --title "{{ project_name }}-devcontainer"
                echo "✓ SSH key generated and added to GitHub"
            else
                echo "✓ SSH key generated and stored in 1Password"
                echo ""
                echo "⚠ GitHub CLI not authenticated. Add the public key manually:"
                echo "  https://github.com/settings/keys"
                echo ""
                cat "$TEMP_KEY.pub"
            fi

            # Clean up temp files
            rm -f "$TEMP_KEY" "$TEMP_KEY.pub"
            ;;
        2)
            # Import existing key
            SSH_KEYS=()
            while IFS= read -r -d '' keyfile; do
                if head -1 "$keyfile" 2>/dev/null | grep -q "PRIVATE KEY"; then
                    SSH_KEYS+=("$keyfile")
                fi
            done < <(find ~/.ssh -maxdepth 1 -type f ! -name "*.pub" ! -name "known_hosts*" ! -name "config" ! -name "authorized_keys" -print0 2>/dev/null)

            if [ ${#SSH_KEYS[@]} -eq 0 ]; then
                echo "No SSH private keys found in ~/.ssh/"
            else
                echo "Available keys:"
                for i in "${!SSH_KEYS[@]}"; do
                    echo "  $((i+1)). ${SSH_KEYS[$i]}"
                done
                echo ""
                read -p "Which key? [1-${#SSH_KEYS[@]}] " key_choice

                if [[ "$key_choice" =~ ^[0-9]+$ ]] && [ "$key_choice" -ge 1 ] && [ "$key_choice" -le ${#SSH_KEYS[@]} ]; then
                    SSH_KEY="${SSH_KEYS[$((key_choice-1))]}"
                    echo "Importing $SSH_KEY..."
                    op item create --category "SSH Key" --vault "$VAULT_NAME" \
                        --title "devcontainer-ssh-key" \
                        --tags "devcontainer" \
                        "private key[password]=$(cat "$SSH_KEY")"
                    echo "✓ SSH key imported"
                fi
            fi
            ;;
        *)
            echo "Skipping SSH key setup."
            ;;
    esac
fi

# Check/create git-config
if op item get "git-config" --vault "$VAULT_NAME" &> /dev/null; then
    echo "✓ git-config exists"
else
    echo ""
    GIT_NAME=$(git config --global user.name 2>/dev/null || echo "")
    GIT_EMAIL=$(git config --global user.email 2>/dev/null || echo "")

    if [ -n "$GIT_NAME" ] && [ -n "$GIT_EMAIL" ]; then
        echo "Creating git-config from local git settings..."
        op item create --category "Secure Note" --vault "$VAULT_NAME" \
            --title "git-config" \
            "name[text]=$GIT_NAME" \
            "email[text]=$GIT_EMAIL"
        echo "✓ git-config created (name: $GIT_NAME, email: $GIT_EMAIL)"
    else
        echo "Creating git-config (please edit in 1Password)..."
        op item create --category "Secure Note" --vault "$VAULT_NAME" \
            --title "git-config" \
            "name[text]=Your Name" \
            "email[text]=your@email.com"
        echo "⚠ git-config created with placeholders - edit in 1Password!"
    fi
fi

# Check/create github-pat
if op item get "github-pat" --vault "$VAULT_NAME" &> /dev/null; then
    echo "✓ github-pat exists"
else
    echo ""
    echo "Creating github-pat placeholder..."
    op item create --category "API Credential" --vault "$VAULT_NAME" \
        --title "github-pat" \
        "credential[password]=paste-your-github-pat-here"
    echo "⚠ github-pat created with placeholder"
    echo "  1. Create a token at: https://github.com/settings/tokens"
    echo "  2. Required scopes: repo"
    echo "  3. Edit 'github-pat' in 1Password and paste the token"
fi

# Check for service account token
echo ""
if [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
    echo "✓ OP_SERVICE_ACCOUNT_TOKEN is set"
else
    echo "⚠ OP_SERVICE_ACCOUNT_TOKEN not set"
    echo ""
    echo "To create a Service Account:"
    echo "  1. Go to: https://my.1password.com/developer-tools/service-accounts"
    echo "  2. Click 'New Service Account'"
    echo "  3. Name it '{{ project_name }}-devcontainer'"
    echo "  4. Grant access to vault '$VAULT_NAME'"
    echo "  5. Copy the token (starts with 'ops_...')"
    echo ""
    read -p "Press Enter after setting OP_SERVICE_ACCOUNT_TOKEN (or Ctrl+C to abort)... "

    if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
        echo ""
        echo "OP_SERVICE_ACCOUNT_TOKEN still not set."
        echo "Set it and re-run, or pass it to devpod:"
        echo "  devpod up ... --workspace-env OP_SERVICE_ACCOUNT_TOKEN=ops_..."
        exit 1
    fi
fi

echo ""
echo "=== 1Password setup complete ==="
