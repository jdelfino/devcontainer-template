#!/bin/bash
# Initialize 1Password vault for this project (runs on HOST via initializeCommand)
# Requires: op CLI installed and signed in on host

set -e

VAULT_NAME="{{ op_vault }}"

# Check if op is available and signed in
if ! command -v op &> /dev/null; then
    echo "1Password CLI (op) not found on host. Skipping vault setup."
    echo "Install from: https://1password.com/downloads/command-line/"
    exit 0
fi

if ! op account list &> /dev/null; then
    echo "Not signed in to 1Password. Run 'op signin' first."
    exit 0
fi

# Check if vault exists
if op vault get "$VAULT_NAME" &> /dev/null; then
    echo "Vault '$VAULT_NAME' already exists."
else
    echo "Creating vault '$VAULT_NAME'..."
    op vault create "$VAULT_NAME"
    echo "Vault created. You'll need to:"
    echo "  1. Create a Service Account at https://my.1password.com/developer-tools/service-accounts"
    echo "  2. Grant it access to '$VAULT_NAME'"
    echo "  3. Set OP_SERVICE_ACCOUNT_TOKEN environment variable"
    echo ""
    echo "Also create these items in the vault:"
    echo "  - SSH Key (tagged 'devcontainer')"
    echo "  - Secure Note 'git-config' with fields: name, email"
    echo "  - Item 'github-pat' with field: credential"
fi
